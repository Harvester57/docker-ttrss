#!/usr/bin/with-contenv sh

# Wait for the DB to be reachable before proceeding. This avoids race condition
# whereby database is not ready (yet), and so TTRSS config isn't correctly created

if [ "$DB_TYPE" = 'mysql' ]; then
    default_port=3306
    legacy_host="$DB_PORT_3306_TCP_ADDR"
    legacy_port="$DB_PORT_3306_TCP_PORT"
else
    default_port=5432
    legacy_host="$DB_PORT_5432_TCP_ADDR"
    legacy_port="$DB_PORT_5432_TCP_PORT"
fi

dbhost="${DB_HOST:-${TTRSS_DB_HOST:-${legacy_host:-db}}}"
eport="${DB_PORT_5432_TCP_PORT:-${DB_PORT_3306_TCP_PORT:-${TTRSS_DB_PORT:-${DB_PORT:-$default_port}}}}"

case "$eport" in
    tcp://*:*)
        if [ "$dbhost" = "db" ]; then
            tmp_host="${eport#tcp://}"
            dbhost="${tmp_host%:*}"
        fi
        eport="${eport##*:}"
        ;;
esac

echo "Checking database responds within 30s on $dbhost:$eport..."
/srv/wait-for "$dbhost:$eport" --timeout=30
